{
  "name": "dsh-git-github",
  "version": "0.1.0",
  "description": "dsh-git 的 GitHub Provider：纯 fetch 调 REST，凭据只存引用（v0.1 尚未实现）",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js.map",
    "lib/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dsh-git-core": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
