{
  "name": "dsh-git-client",
  "version": "0.1.0",
  "description": "dsh-git 的 Web 侧边栏面板：状态 / 提交 / 历史 / diff（v0.1 尚未实现）",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js.map",
    "lib/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dsh-git-core": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
