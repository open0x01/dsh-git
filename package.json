{
  "name": "dsh-git-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 的 Git / GitHub 插件套件：统一契约、零外部二进制依赖、默认安全",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm typecheck && pnpm build && pnpm test && pnpm smoke",
    "clean": "pnpm -r exec node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "pack:bundle": "pnpm --filter dsh-git pack"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.9.2",
    "@types/react": "^18.3.31",
    "dsh-git-core": "workspace:^",
    "dsh-git-local": "workspace:^",
    "dsh-git-policy": "workspace:^",
    "dsh-git-tool-git": "workspace:^",
    "tsdown": "^0.23.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
